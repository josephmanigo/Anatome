  record:
    id: REC_Left_Visceral_Pleura
    name: Left visceral pleura
    object_name: A_REC_Left_Visceral_Pleura
    system: Respiratory
    tissue: membrane
    source_kind: authored_reconstruction
    source_record: docs/reconstructions.json
    required_group: pleural_layers
    notes: 'Thin membrane envelope around registered MAL lung extent; simplified
      hilum and fissural reflections. Layer gap and thickness selected for visibility,
      with spatial relationships referenced to Gray 968. Educational reconstruction;
      dimensions are author-selected, not measured tissue parameters. Production
      teaching adaptation: the complete five-lobe set shares a further uniform scale
      of 0.916 and translation against the BP3D cage envelope. Original MAL specimen
      remains separate and unchanged. See docs/lung-production-adaptation.json. This
      geometric fit does not validate hilar alignment.'
    anatomical_identifier: 
    layer: 4
    cutting_ready: 1
    reference_region: 0
    mesh_ids: []
  interiorMaterial: {fileID: 2100000, guid: e15105f476663ac4391bfea53833679c, type: 2}
